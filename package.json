{
  "name": "interior3d",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:test": "tsc && vite build --mode test",
    "preview": "vite preview",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "tsx scripts/check-test-contracts.ts",
    "test:retail-assets": "tsx scripts/check-retail-assets.ts",
    "test:mesh-assets": "tsx scripts/check-generated-mesh-assets.ts",
    "test:bundle-budget": "tsx scripts/check-bundle-budget.ts",
    "mesh:stage": "tsx scripts/stage-generated-mesh.ts",
    "mesh:publish": "tsx scripts/publish-generated-mesh.ts",
    "mesh:fingerprint": "tsx scripts/product-mesh-fingerprint.ts",
    "mesh:review": "tsx scripts/create-generated-mesh-review.ts",
    "mesh:experiment:kivik": "tsx scripts/kivik-multiview-feasibility.ts",
    "mesh:experiment:kivik:regenerate": "tsx scripts/kivik-multiview-regeneration.ts",
    "mesh:service:build": "docker compose -f services/triposr-worker/compose.yaml build",
    "mesh:service:start": "docker compose -f services/triposr-worker/compose.yaml up -d",
    "mesh:service:stop": "docker compose -f services/triposr-worker/compose.yaml down",
    "mesh:service:health": "tsx scripts/check-triposr-service.ts",
    "typecheck:architecture": "tsc -p tsconfig.domain.json && tsc -p tsconfig.application.json",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:preview": "npm run build:test && playwright test --config=playwright.preview.config.ts",
    "verify": "npm run test:contracts && npm run test:retail-assets && npm run test:mesh-assets && npm run typecheck:architecture && npm run lint && npm run format:check && npm run test:coverage && npm run build && npm run test:bundle-budget",
    "verify:full": "npm run verify && npm run test:e2e && npm run test:preview",
    "lint": "eslint src e2e scripts/*.ts --max-warnings 0",
    "format": "prettier --write src e2e scripts/*.ts \"*.{js,ts,json,md}\" --log-level warn",
    "format:check": "prettier --check src e2e scripts/*.ts \"*.{js,ts,json,md}\" --log-level warn",
    "benchmark:cv": "tsx scripts/cv-accuracy-benchmark.ts",
    "cv:setup": "python scripts/setup_cv_runtime.py",
    "cv:server": "python scripts/cv_inference_server.py",
    "demo:gif": "tsx scripts/capture-readme-demo.ts",
    "shots": "node scripts/walkthrough.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "sharp": "^0.35.4",
    "tsx": "^4.23.12",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^5.4.10",
    "vitest": "^4.1.11"
  }
}
